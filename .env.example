# =============================================================================
# Veyl environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# --- Core -------------------------------------------------------------------
VEYL_ENV=development
VEYL_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
VEYL_ACCESS_TOKEN_TTL_MINUTES=60
VEYL_REFRESH_TOKEN_TTL_DAYS=7

# --- Database ---------------------------------------------------------------
# Dev default is SQLite so the stack runs without Docker/Postgres.
# Production / docker-compose uses Postgres:
#   postgresql+psycopg://veyl:veyl@db:5432/veyl
VEYL_DATABASE_URL=sqlite:///./veyl.db

# --- Safety -----------------------------------------------------------------
# Veyl refuses to scan anything not present in the Scope Registry with a valid
# authorization record. These knobs control the network safety floor.
#
# ALLOW_PRIVATE_TARGETS MUST remain false for any publicly reachable deployment.
# Enabling it permits scanning RFC1918 / loopback / link-local addresses, which
# is only correct for an internally hosted, trusted deployment.
VEYL_ALLOW_PRIVATE_TARGETS=false
# When true, cloud metadata endpoints (169.254.169.254 et al.) stay blocked even
# if ALLOW_PRIVATE_TARGETS is on. Only disable for isolated lab networks.
VEYL_ALWAYS_BLOCK_METADATA=true
VEYL_ALLOWED_SCAN_PORTS=1-1024,3306,3389,5432,6379,8000-8100,8443,9000,9200,27017
VEYL_SCAN_TIMEOUT_SECONDS=5.0
VEYL_SCAN_MAX_CONCURRENCY=64

# --- Nmap (optional) --------------------------------------------------------
# If nmap is absent, Veyl uses its built-in TCP connect scanner. No hard failure.
VEYL_NMAP_ENABLED=false
VEYL_NMAP_BINARY=nmap

# --- Threat intelligence (optional, modular) --------------------------------
VEYL_CVE_PROVIDER=local          # local | osv | none
VEYL_OSV_API_URL=https://api.osv.dev

# --- AI assistance (optional; never writes evidence) ------------------------
VEYL_AI_ENABLED=false
VEYL_AI_BASE_URL=
VEYL_AI_API_KEY=
VEYL_AI_MODEL=

# --- Rate limiting ----------------------------------------------------------
VEYL_RATE_LIMIT_PER_MINUTE=120

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
